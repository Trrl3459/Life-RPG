@page "/character"
@inject CharacterService CharacterService
@inject ISnackbar Snackbar

<PageTitle>Character</PageTitle>

<MudText Typo="Typo.h4" Class="ma-4">Character Sheet</MudText>

@if (Player is null)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudGrid Class="pa-2">
        <MudItem xs="12" md="6">
            <CharacterSummary Player="Player" />
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Class="ma-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Identity</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value="_name" Label="Character Name" Immediate="true" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveName">Save Name</MudButton>
                </MudCardActions>
            </MudCard>

            @if (ShowDebugTools)
            {
                <MudCard Class="ma-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Debug Tools</MudText>
                            <MudText Typo="Typo.caption">Only present in Debug builds.</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" OnClick="() => GainXp(5)">+5 XP</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="() => GainGold(10)">+10 Gold</MudButton>
                    </MudCardActions>
                </MudCard>
            }
        </MudItem>
    </MudGrid>
}

@code {
#if DEBUG
    private static bool ShowDebugTools => true;
#else
    private static bool ShowDebugTools => false;
#endif

    private LifeRPG.Data.Character? Player;
    private string _name = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Player = await CharacterService.GetOrCreateAsync();
        _name = Player.Name;
    }

    private async Task GainXp(int amount)
    {
        await CharacterService.AddXPAsync(amount);
        Player = await CharacterService.GetOrCreateAsync();
    }

    private async Task GainGold(int amount)
    {
        await CharacterService.AddGoldAsync(amount);
        Player = await CharacterService.GetOrCreateAsync();
    }

    private async Task SaveName()
    {
        await CharacterService.SetNameAsync(_name);
        Player = await CharacterService.GetOrCreateAsync();
        _name = Player.Name;
        Snackbar.Add("Name saved.", Severity.Success);
    }
}
