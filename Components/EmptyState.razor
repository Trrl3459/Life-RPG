<MudPaper Class="rpg-empty-state pa-6 ma-4" Elevation="0">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icon" Color="@IconColor" Size="Size.Large" Class="rpg-empty-icon" />
        <MudText Typo="Typo.h6" Align="Align.Center">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">@Message</MudText>
        }
        @if (ActionText is not null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ActionHref" OnClick="OnAction">
                @ActionText
            </MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Explore;

    [Parameter]
    public Color IconColor { get; set; } = Color.Tertiary;

    [Parameter]
    public string? ActionText { get; set; }

    [Parameter]
    public string? ActionHref { get; set; }

    [Parameter]
    public EventCallback OnAction { get; set; }
}
